# Copy this file to .env and fill in your own key:
#   cp .env.example .env && chmod 600 .env
#
# VITE_MAPTILER_KEY is injected at build time (see vite.config.mjs) and is
# necessarily visible in the shipped bundle. It is therefore protected by
# restricting the key to your origins in the MapTiler dashboard, not by hiding
# it. Never commit .env — see docs/maptiler-key-security.md.
VITE_MAPTILER_KEY=
