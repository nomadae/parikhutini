# Security headers for the deployed site.
#
# This file is copied verbatim to `dist/_headers` by Vite (public/ passthrough)
# and is understood natively by Netlify and Cloudflare Pages. For nginx, Apache,
# GitHub Pages or an object store, see docs/security-headers.md.
#
# The app ships every script, style and font itself (no third-party CDN), so the
# policy below needs no external script/style origins. MapTiler remains the only
# external data dependency. If you ever add a CDN back, extend the relevant
# directive *and* add Subresource Integrity to the tag.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.maptiler.com; connect-src 'self' https://*.maptiler.com; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# Long-lived, immutable hashed assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never let a browser (or intermediary) sniff the data files as HTML/JS.
/data/*
  X-Content-Type-Options: nosniff
